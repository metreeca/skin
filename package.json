{
  "name": "@metreeca/skin",
  "version": "0.3.0",
  "description": "Essential design tokens and styles.",
  "keywords": [
    "typescript",
    "css",
    "design-system",
    "tokens",
    "ui"
  ],
  "homepage": "https://metreeca.github.io/skin/",
  "bugs": {
    "url": "https://github.com/metreeca/skin/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/skin.git"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "@metreeca/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./index.css": {
      "@metreeca/source": "./src/index.css",
      "default": "./dist/index.css"
    },
    "./presets/inter.css": {
      "@metreeca/source": "./src/presets/inter.css",
      "default": "./dist/presets/inter.css"
    },
    "./presets/roboto.css": {
      "@metreeca/source": "./src/presets/roboto.css",
      "default": "./dist/presets/roboto.css"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "ush rm dist docs node_modules",
    "prime": "npm ci",
    "setup": "npm ci && ush ln",
    "build": "ush rm dist docs && tsc -p tsconfig.build.json && ush cp dist 'src/**/*.css' && npx typedoc && npx vite build lab",
    "check": "npx vitest --typecheck run",
    "proof": "npx typedoc --watch & ush ws --open docs",
    "watch": "npx vite lab --open"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-condensed": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0"
  },
  "devDependencies": {
    "@csstools/color-helpers": "^6.1.2",
    "@csstools/css-color-parser": "^4.2.7",
    "@csstools/css-parser-algorithms": "^4.0.2",
    "@csstools/css-tokenizer": "^4.0.2",
    "@metreeca/rack": "^0.6.1",
    "@types/node": "^22.20.4",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "fsevents": true
  }
}
